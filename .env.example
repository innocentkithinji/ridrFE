# Where the Ridr API listens; `make up` serves it here.
VITE_RIDR_API_URL=http://localhost:18095
# The local stack's dev token; the app signs in with it when no Clerk key is set.
# A production build needs this or the Clerk key, so name it to build for a local stack.
VITE_RIDR_DEV_TOKEN=dev-user-token
# Sign in with Clerk instead of the dev token (pk_test_… or pk_live_…).
# VITE_CLERK_PUBLISHABLE_KEY=
# Draw maps with Google Maps instead of the keyless OpenFreeMap base map.
# Both are needed; the Map ID must be a JavaScript vector map with Tilt and
# Rotation on. See "Google Maps" in the README for keeping it free.
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAP_ID=
