{
  "name": "ridr-web",
  "private": true,
  "version": "0.0.0",
  "description": "The Ridr web app for Operations managers.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "test:e2e": "playwright test",
    "test:e2e:worker": "VITE_RIDR_DEV_TOKEN=dev-user-token npm run build && E2E_SERVER=worker playwright test e2e/deploy.spec.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@clerk/react": "6.17.4",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-web": "2.2.0",
    "@fontsource-variable/geist": "5.3.0",
    "@ridr/web": "file:../Ridr/sdk/web",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eventsource-parser": "4.1.1",
    "lucide-react": "1.58.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "shadcn": "4.22.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.146.0"
  }
}
